# Провайдер LLM: gemini | openai_compat | ollama
LLM_PROVIDER=gemini

# Ключ и модель Gemini (модель выберем на Этапе 1)
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI-совместимый API (если используешь OpenRouter / Groq / др.)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Локальный сервер Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Локальная модель эмбеддингов (HuggingFace)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Пути и локальная база данных
DATA_DIR=data
DATABASE_URL=sqlite:///data/examrag.db
